# Run npm run setup to generate safe local values in .env.local.
SESSION_SECRET=
DEVELOPER_PASSWORD=
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# Public demo: blocks private sign-in and uses a disposable database.
DEMO_ONLY=false
# Optional. Omit to use embedded PostgreSQL (PGlite) in .data/postgres.
# DATABASE_URL=postgresql://playtest:LOCAL_PASSWORD@127.0.0.1:5432/playtest
